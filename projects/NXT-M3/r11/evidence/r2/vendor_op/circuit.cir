NXT R11 5 V boost, populated candidate in simulation only
* R40 installed as a simulation assumption. V5 is upstream equivalent 5 V rail.
* U11 RON / disconnect, U16 timed bias switch, U18 gate paths, Q32/D3 are proxies.
.param RLINK=1m CIN=26.8u COUT=3.3u LSER=39.5m LMAIN=22u
.include LM5155-Q1_TRANS.LIB
V5 VIN 0 PWL(0 0 100u 5 35m 5)
R40 VIN ISOLATE {RLINK}
S11 ISOLATE VHV ARMED 0 EFUSE
.model EFUSE SW(Ron=28m Roff=1G Vt=1.6 Vh=0.05)
V_ARM ARMED 0 PWL(0 0 300u 0 310u 3.3 35m 3.3)
C28 VHV 0 22u
C37 VHV 0 4.7u
C46 VHV 0 100n
R45 VHV 0 10k
L2 VHV BSW 10u
D2 BSW BIAS SS14_PROXY
.model SS14_PROXY D(Is=15u N=1.15 Rs=0.07 Cjo=80p BV=40)
V_BCLOCK BCLK 0 PULSE(0 1 330u 10n 10n 440n 1.66u)
B_BCTL BCTL 0 V={v(BCLK)*(0.5+0.5*tanh((1.233-v(BFB))*500))*v(ARMED)/3.3}
S16 BSW 0 BCTL 0 BIAS_SWITCH
.model BIAS_SWITCH SW(Ron=1.2 Roff=1G Vt=.5 Vh=.04)
R70 BIAS BFB 845k
R71 BFB 0 100k
C38 BIAS 0 4.7u
C39 BIAS 0 100n
C45 BIAS 0 1u
R50 BIAS BSENSE 64.9k
R51 BSENSE 0 10k
B_PERMIT PERMIT 0 V={v(ARMED)*(0.5+0.5*tanh((v(BSENSE)-1.25)*500))}
R77 PERMIT UVLO 10k
R78 UVLO 0 47k
X17 0 VHV COMP CS 0 FB PWM 0 READY RT SS UVLO VCC LM5155-Q1_TRANS PARAMS: LM51551=0 SS=0
R53 V33 READY 10k
V33 V33 0 PWL(0 0 250u 3.3)
C40 VCC 0 2.2u
C41 SS 0 100n
R79 RT 0 220k
R80 COMP CZ 10k
C43 CZ 0 10n
C44 COMP 0 100p
R72 SNS CS 100
C42 CS 0 100p
R73 SNS 0 50m
R49 SNS CS_FILT 470
C31 CS_FILT 0 100p
R47 VREF OCP_REF 93.1k
R48 OCP_REF 0 10k
VREF VREF 0 1.25
B_GCTL GH 0 V={0.5+0.5*tanh((v(PWM)-2.2)*50)}
B_GLO GL 0 V={1-v(GH)}
S18_H BIAS GP GH 0 OUTSW
S18_L GN 0 GL 0 OUTSW
.model OUTSW SW(Ron=1.2 Roff=1G Vt=.5 Vh=.02)
R74 GP G 10
R75 GN G 4.7
R76 G SNS 10k
RLD VHV LI {LSER}
L3 LI SW {LMAIN}
VQ SW DRAIN 0
M32 DRAIN G SNS SNS ST_PROXY
.model ST_PROXY NMOS(Level=1 VTO=3.5 KP=12 RD=.32 RS=.03 CGSO=900p CGDO=90p CBD=45p PB=.8 IS=1n)
* Q32 breakdown is outside the proxy.
B_VDS VDS 0 V={v(SW,SNS)}
VD SW DA 0
D3 DA HV ES1G_PROXY
.model ES1G_PROXY D(Is=8n N=1.9 Rs=.32 Cjo=13p Tt=20n BV=400 IBV=10u)
R86 SW SNUB 100
C48 SNUB 0 100p
VC HV CO 0
RESR CO FILM 25m
C47 FILM 0 {COUT}
R81 HV FB1 422k
R82 FB1 FB2 422k
R83 FB2 FB3 422k
R84 FB3 FB 422k
R85 FB 0 10k
R60 HV OVP1 499k
R61 OVP1 OVP2 499k
R62 OVP2 OVP3 499k
R63 OVP3 OVP 499k
R64 OVP 0 13.3k
C35 OVP 0 100p
R65 HV RES1 453k
R66 RES1 RES2 453k
R67 RES2 RES3 453k
R68 RES3 RESID 453k
R69 RESID 0 42.2k
C36 RESID 0 100p
R400 HV B11 124k
R401 B11 B12 124k
R402 B12 B13 124k
R403 B13 0 124k
R404 HV B21 124k
R405 B21 B22 124k
R406 B22 B23 124k
R407 B23 0 124k
* Equivalent three static tubes at nominal current; extinction proxy below 120 V.
VLOAD REQUEST 0 7.65m
BLOAD HV 0 I={v(REQUEST)*min(1,max(0,(v(HV)-120)/15))}
B_PQ PQ 0 V={v(SW,SNS)*i(VQ)}
B_PD PD 0 V={v(DA,HV)*i(VD)}
B_RL PL 0 V={i(L3)*i(L3)*LSER}
B_RCS PCS 0 V={v(SNS)*v(SNS)/.05}
.options method=gear reltol=0.003 abstol=1n
.save v(HV) v(BIAS) v(FB) v(OVP) v(COMP) v(CS) v(SNS) v(SW) v(G) v(VHV) v(PWM) v(VDS) v(DA) v(PQ) v(PD) v(PL) v(PCS) i(L3) i(VQ) i(VD) i(VC) i(V5)
.tran 200n 30m 0 150n
.meas tran hv_final AVG v(HV) FROM=28m TO=30m
.meas tran hv_ripple PP v(HV) FROM=28m TO=30m
.meas tran hv_peak MAX v(HV)
.meas tran t_95 WHEN v(HV)=161.5 RISE=1
.meas tran il_peak MAX i(L3)
.meas tran q_vds MAX v(VDS)
.meas tran q_current MAX i(VQ)
.meas tran d_vr MAX par('v(HV)-v(DA)')
.meas tran d_if MAX i(VD)
.meas tran d_irev MIN i(VD)
.meas tran input_peak MIN i(V5)
.meas tran cs_peak MAX v(SNS)
.meas tran cap_charge MAX i(VC)
.meas tran cap_discharge MIN i(VC)
.meas tran cap_rms RMS i(VC) FROM=28m TO=30m
.meas tran q_loss AVG v(PQ) FROM=28m TO=30m
.meas tran d_loss AVG v(PD) FROM=28m TO=30m
.meas tran l_copper AVG v(PL) FROM=28m TO=30m
.meas tran sense_loss AVG v(PCS) FROM=28m TO=30m
.meas tran bias_peak MAX v(BIAS)
.end

