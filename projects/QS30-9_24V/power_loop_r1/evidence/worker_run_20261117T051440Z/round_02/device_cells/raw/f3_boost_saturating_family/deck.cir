* F3b boost switch node 24 V -> D=0.65 @ 500 kHz, 3 periods
.temp 27
Vbus NVBP 0 24
Vsw NVSW 0 PWL(0 0 0.04u 0 0.06u 1 1.32u 1 1.34u 0 3.32u 0 3.34u 1 4.62u 1 4.64u 0 6.64u 0 6.66u 1 7.92u 1 9.22u 1)
Ssw NVDP 0 NVSW 0 SWM
.model SWM SW(VT=0.5 RON=1m ROFF=100meg)
Vds 0 NVDP 0
Bfl NSAT 0 V=Lslot*x/(1+(abs(i(L1))/x)**2)
L1 NVBP NSAT 1m IC=0
.param Lslot=150u x=9.7
D1 NVDP NVOP DUF
.model DUF D(IS=1e-9 N=1.7 RS=0.05 BV=1000 CJO=20p TT=100n)
Co NVOP 0 47u
Rld NVOP 0 3k
.options reltol=1e-4 abstol=1e-12 vntol=1e-8 chgtol=1e-15
.tran 1e-08 1.5325e-05 0 uic
