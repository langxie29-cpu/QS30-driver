.control
set noaskquit
set wr_singlescale
set wr_vecnames
tran 2e-08 0.009 0.005 2e-08
meas tran native_end MAX time
let j = @v_v1[i]
wrdata waves.txt v(vdd) v(vin) v(out) v(cs) v(comp) v(fb) v(vref) v(rtct) v(j)
